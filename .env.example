# Copia este archivo a ".env" y completa los valores reales.
# Nunca subas el archivo ".env" (con las claves reales) a un repositorio publico.

# --- Supabase ---
# URL del proyecto Supabase (Project Settings > API)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publica "anon" (Project Settings > API). La usa el frontend/dashboard
# para autenticar al especialista contra Supabase Auth.
SUPABASE_ANON_KEY=tu-anon-key

# Clave privada "service_role" (Project Settings > API). SOLO la usa el backend
# (FastAPI) para las operaciones automatizadas del pipeline (bypassa RLS).
# NUNCA exponer esta clave al frontend ni al navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Nombre del bucket de Supabase Storage donde se guardan los PDFs originales.
SUPABASE_STORAGE_BUCKET=documentos-aduaneros

# --- Gemini (Google AI Studio, free tier) ---
GEMINI_API_KEY=tu-gemini-api-key

# --- Backend FastAPI ---
# URL base donde corre el backend, usada por el dashboard de Streamlit.
API_BASE_URL=http://localhost:8000

# Origen permitido para CORS (el dashboard de Streamlit en desarrollo local).
CORS_ORIGIN=http://localhost:8501
